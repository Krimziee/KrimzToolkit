<!--
    Krimz's Toolkit window: the title and one tab per tool along the top, and
    the selected tool's page underneath. The tabs and pages are added by
    modules\Shell.ps1 from tools.psd1. Styles come from ui\Theme.xaml.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Krimz's Toolkit" Width="1180" Height="900" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Background}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#F3F3F3"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid Background="{StaticResource Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: name on the left, tabs next to it -->
        <Border Grid.Row="0" Background="#202020" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{StaticResource Accent}"
                               VerticalAlignment="Center" Margin="0,1,10,0"/>
                    <TextBlock Text="Krimz's Toolkit" FontFamily="{StaticResource Display}" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="TabBar" Grid.Column="1" Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once"/>
                <TextBlock x:Name="VersionText" Grid.Column="2" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Pages: all stay loaded, only the selected one is visible -->
        <Grid x:Name="PageHost" Grid.Row="1"/>
    </Grid>
</Window>
